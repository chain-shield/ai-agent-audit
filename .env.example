RUST_LOG=info

# OpenAI review uses cached ChatGPT/Codex OAuth by default. This is the
# recommended path for long audit runs because it is far more cost-effective
# than direct API billing.
AI_AGENT_AUDIT_OPENAI_BACKEND=codex

# Optional fallback for Rust OpenAI calls when you do not have Codex/ChatGPT
# access. The deep validation worker workflow still requires a filesystem-
# capable Codex-style agent launcher.
# AI_AGENT_AUDIT_OPENAI_BACKEND=api
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_AI_API_KEY=your_gemini_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Discovery provider/model selection now lives in `src/config.rs`.
# Edit `DISCOVERY_PROVIDER`, `GEMINI_DISCOVERY_MODEL`, and
# `DISCOVERY_GEMINI_THINKING_LEVEL` there if you want to change defaults.

# Optional: for auditing private GitHub repositories
# GITHUB_TOKEN=your_github_token

# Optional: override where local SQLite state is stored
# AI_AGENT_AUDIT_DATA_DIR=.ai-agent-audit

# Optional: override the Codex-compatible validation worker launcher used by
# scripts/three_shot_round.py run. This env var wins over YAML launcher values.
# AI_AGENT_AUDIT_WORKER_LAUNCHER=codex
