RUST_LOG=info

# OpenAI review now uses cached ChatGPT/Codex OAuth at startup.
# No OPENAI_API_KEY is required for the default path.
# OPENAI_API_KEY=sk-legacy_key_if_you_still_need_it
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_AI_API_KEY=your_gemini_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional: switch discovery-style runs (patterns, actors, invariants) to Gemini.
# Defaults are provider=openai and model=gpt-5.4 through Codex.
# AI_AGENT_AUDIT_DISCOVERY_PROVIDER=gemini
# AI_AGENT_AUDIT_DISCOVERY_MODEL=gemini-3-pro-preview
# AI_AGENT_AUDIT_DISCOVERY_GEMINI_THINKING_LEVEL=high

# Optional: for auditing private GitHub repositories
# GITHUB_TOKEN=your_github_token

# Optional: override where local SQLite state is stored
# AI_AGENT_AUDIT_DATA_DIR=.ai-agent-audit
