{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-audit.local/schemas/code4rena-competition.schema.json",
  "title": "Code4renaCompetition",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "uid",
    "title",
    "audit_type",
    "league",
    "start_time",
    "end_time",
    "repo_url",
    "report_url",
    "archive"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "slug": { "type": "string" },
    "uid": { "type": "string" },
    "contest_id": { "type": ["integer", "null"] },
    "title": { "type": "string" },
    "audit_type": { "type": ["string", "null"] },
    "league": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "start_time": { "type": ["string", "null"], "format": "date-time" },
    "end_time": { "type": ["string", "null"], "format": "date-time" },
    "repo_url": { "type": ["string", "null"] },
    "findings_repo_url": { "type": ["string", "null"] },
    "known_findings_repo_url": { "type": ["string", "null"] },
    "report_url": { "type": "string" },
    "source_repositories_from_report": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo_url", "commit_hash"],
        "properties": {
          "repo_url": { "type": "string" },
          "commit_hash": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "benchmark_candidate": { "type": "boolean" },
    "benchmark_candidate_reason": { "type": "string" },
    "raw_code4rena_audit": { "type": "object" },
    "archive": {
      "type": "object",
      "required": ["captured_at", "public_metadata_status", "final_report_status", "submissions_status"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "public_metadata_status": { "type": "string" },
        "final_report_status": { "type": "string" },
        "submissions_status": { "type": "string" },
        "authenticated_submissions_endpoint": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
